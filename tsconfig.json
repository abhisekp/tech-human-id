{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2018", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "noEmit": true
  },
  "include": ["*.ts", "data/*.ts"],
  "exclude": ["node_modules", "dist"]
}
