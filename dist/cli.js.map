{
  "name": "tech-human-id",
  "version": "5.0.8",
  "description": "Zero-dependency, human-readable identifiers made from tech terms",
  "browser": "dist/index.js",
  "main": "dist/index.cjs",
  "source": "index.ts",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "bin": {
    "tech-human-id": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "examples.ts",
    "index.ts",
    "cli.ts"
  ],
  "scripts": {
    "watch": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "gen-cli": "node scripts/build.mjs",
    "examples": "node scripts/build.mjs && node dist/examples.js",
    "prepare": "husky",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test:package": "node scripts/test-package.mjs",
    "verify": "npm run typecheck && npm test -- --runInBand && npm run test:release && npm run build && npm run test:package && npm run build:site",
    "prepack": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean-only",
    "test:release": "node scripts/test-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisekp/tech-human-id.git"
  },
  "keywords": [
    "human",
    "readable",
    "id",
    "identifier"
  ],
  "author": "RienNeVaPlus <?@rienneva.plus>",
  "contributors": [
    {
      "name": "Abhisek Pattnaik",
      "email": "abhisekp@engineer.com",
      "url": "https://about.me/abhisekp"
    }
  ],
  "browserslist": [
    "> 0.5%, last 2 versions, not dead"
  ],
  "homepage": "https://tech-human-id.js.org",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abhisekp/tech-human-id/issues"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "sideEffects": false
}
